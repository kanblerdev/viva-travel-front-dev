# Las variables NEXT_PUBLIC_* se INCRUSTAN durante el build, no se leen en
# ejecución. En Vercel hay que definirlas ANTES del primer despliegue, y todo
# cambio exige un redeploy: reiniciar el proyecto no basta.
#
# Sin barra final en las URL: el cliente del API las concatena con rutas que ya
# empiezan por "/".

# API del CRM (proyecto backend/)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Panel administrativo (proyecto backoffice/)
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001

# Firebase Auth — cliente web (Sprint 2)
# Estos valores son públicos por diseño; los secretos viven solo en el backend.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Bandeja de mensajería en el menú (Sprint 6). "true" solo donde Meta ya manda
# eventos al API —o en desarrollo, con `npm run meta:simulate` en el backend—.
# Sin la variable, la opción no aparece; la ruta /bandeja sigue respondiendo.
NEXT_PUBLIC_MESSAGING_ENABLED=false
